{
  "name": "jeffy",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env.local --import tsx minimal_agent.ts",
    "test": "node --import tsx --test gateway/src/index.test.ts",
    "typecheck": "tsc --noEmit",
    "gateway:dev": "wrangler dev --config gateway/wrangler.jsonc",
    "gateway:deploy": "wrangler deploy --config gateway/wrangler.jsonc",
    "gateway:configure-local": "node scripts/configure-local-gateway.mjs",
    "gateway:smoke": "node --env-file=.env.local scripts/smoke-gateway.mjs",
    "gateway:secret:openai": "wrangler secret put OPENAI_API_KEY --config gateway/wrangler.jsonc",
    "gateway:secret:token": "wrangler secret put GATEWAY_TOKEN --config gateway/wrangler.jsonc"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.1"
  }
}
